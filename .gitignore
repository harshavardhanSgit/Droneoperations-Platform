# Dependencies — installed by `npm install`, never committed
node_modules/

# Build output — generated by `npm run build`, never committed
dist/
build/
*.tsbuildinfo

# Environment — never commit secrets. The .example template IS committed.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Test output
coverage/

# Desktop tool state — not part of the project
.freebuff/
