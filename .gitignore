# Dependencies — installed by `npm install`, never committed
node_modules/

# Build output — generated by `npm run build`, never committed
dist/
build/
*.tsbuildinfo

# Environment — never commit secrets. The .example template IS committed.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Test output.
#
# ANCHORED on purpose. A bare `coverage/` matches a directory of that name at
# any depth, which silently swallowed src/modules/coverage/, app/coverage/ and
# features/coverage/ — source that the build imports. The repo compiled locally
# and could not compile from a clone.
#
# Jest writes to apps/<workspace>/coverage (jest.config.js sets
# coverageDirectory: '../coverage' against rootDir: 'src').
/coverage/
apps/*/coverage/

# Desktop tool state — not part of the project
.freebuff/
