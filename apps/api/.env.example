# TEMPLATE — this file IS committed. Never put real values here.
#   cp .env.example .env
#
# Every variable here must also appear in src/config/env.validation.ts.
# That file enforces it; this file documents it.

NODE_ENV=development

PORT=3000

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://USER@localhost:5432/drone_ops_dev?schema=public"

# Browser origin permitted to send cookies to this API.
WEB_ORIGIN=http://localhost:3010

# Generate your own — never reuse one across environments:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

API_PUBLIC_URL=http://localhost:3000
STORAGE_LOCAL_DIR=.storage
UPLOAD_MAX_BYTES=5242880
