# TEMPLATE — this file IS committed. Never put real values here.
#   cp .env.example .env
#
# Every variable here must also appear in src/config/env.validation.ts.
# That file enforces it; this file documents it.

NODE_ENV=development

PORT=3000

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://USER@localhost:5432/drone_ops_dev?schema=public"

# Browser origin permitted to send cookies to this API.
WEB_ORIGIN=http://localhost:3010

# Generate your own — never reuse one across environments:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

API_PUBLIC_URL=http://localhost:3000
STORAGE_LOCAL_DIR=.storage
UPLOAD_MAX_BYTES=5242880

# Public analytics endpoint (GET /api/v1/coverage/public) hardening.
# Requests per minute per client IP, and how long the aggregation may be
# served from the in-memory TTL cache before the database is queried again.
COVERAGE_PUBLIC_RATE_LIMIT=120
COVERAGE_PUBLIC_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Push notifications (Firebase Cloud Messaging) — OPTIONAL.
#
# Leave these unset and the app runs exactly as before: notifications still
# land in the bell, and the API logs "Push notifications disabled" once at
# boot. Nothing else changes.
#
# From the Firebase console → Project settings → Service accounts →
# "Generate new private key". The downloaded JSON contains all three.
#
# FIREBASE_PRIVATE_KEY is a PEM block with real newlines. Hosting dashboards
# store it as one line with literal \n sequences — that is fine, the API
# converts them back. Keep the surrounding quotes.
#
# THIS IS A SECRET. It is the half that can actually send. Never commit it.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
