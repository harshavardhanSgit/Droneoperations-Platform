# Package-specific ignores. Repo-wide rules live in the root .gitignore.

# Prisma's generated client. This is BUILD OUTPUT, not source code — it is
# regenerated by `prisma generate` from schema.prisma. Committing it would mean
# reviewing tens of thousands of generated lines on every schema change.
/src/generated/

# Local-disk storage adapter output (development only)
/.storage/
