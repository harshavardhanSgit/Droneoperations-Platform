# TEMPLATE — this file IS committed. Never put real values here.
#   cp .env.example .env.local
#
# NEXT_PUBLIC_ variables are embedded into the browser bundle at build time and
# are visible to anyone. Never put a secret behind that prefix.

NEXT_PUBLIC_API_URL=http://localhost:3000

# Map tiles for the location picker (provider onboarding). Defaults to
# OpenStreetMap's public tiles — no key required, free, good India coverage.
# To upgrade, set a Mapbox token (Streets tiles, billing required) or point
# NEXT_PUBLIC_MAP_TILE_URL at any XYZ tile server.
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_MAP_TILE_URL=
