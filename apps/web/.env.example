# TEMPLATE — this file IS committed. Never put real values here.
#   cp .env.example .env.local
#
# NEXT_PUBLIC_ variables are embedded into the browser bundle at build time and
# are visible to anyone. Never put a secret behind that prefix.

NEXT_PUBLIC_API_URL=http://localhost:3000

# Map tiles for the location picker (provider onboarding). Defaults to
# OpenStreetMap's public tiles — no key required, free, good India coverage.
# To upgrade, set a Mapbox token (Streets tiles, billing required) or point
# NEXT_PUBLIC_MAP_TILE_URL at any XYZ tile server.
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_MAP_TILE_URL=

# ---------------------------------------------------------------------------
# Push notifications (Firebase Cloud Messaging) — OPTIONAL.
#
# Leave these unset and the bell behaves exactly as before; the "get notified"
# row simply never appears.
#
# These are PUBLIC values. Firebase web config identifies a project — it
# authorises nothing, which is why Google ships it in client bundles by design.
# Do not let the name "apiKey" suggest otherwise; the secret half is the
# service account, and that belongs only in the API's environment.
#
# Firebase console → Project settings → General → Your apps → Web app → Config.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
#
# Firebase console → Project settings → Cloud Messaging → Web Push
# certificates → "Generate key pair". This is the public half of the VAPID pair.
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
#
# REMEMBER: also paste the same five config values into
# apps/web/public/firebase-messaging-sw.js. A service worker has no build step
# and cannot read these — see the comment at the top of that file.
